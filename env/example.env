# =============================================================================
# example.env — Storage LTA onboarding configuration template
#
# Copy this file and edit for your cloud:
#   cp env/example.env env/cloud<NN>.env
#
# Then run: setup-storage-lta.sh -e env/cloud<NN>.env <stage>
#
# Only CLOUD_ID and STORAGE_ARRAYS are required. Everything else is
# auto-discovered from the QUADS API or has sensible defaults.
# =============================================================================

# ---- Required ---------------------------------------------------------------

# The cloud allocation ID (1-99). Hosts and interfaces are auto-discovered
# from the QUADS API: /api/v3/hosts?cloud=cloud<NN>
CLOUD_ID=15

# Which storage arrays to configure VLAN interfaces for.
# Known vendors: ibm, pure, netapp-asa, netapp-aff
# Each vendor gets two VLANs (path A + path B) distributed across the
# physical NICs using the alternating convention.
STORAGE_ARRAYS="ibm netapp-aff"

# ---- Optional (defaults shown) ----------------------------------------------

# Which BIOS-level network numbers to use for storage (maps to emN).
# Default "3 4" means em3 and em4 — the standard storage networks on
# R640, R650, R660 etc. per ScaleLabTipsAndTricks.
# The alternating path convention distributes VLANs across these:
#   em3: vendor1-pathA, vendor2-pathB, vendor3-pathA, ...
#   em4: vendor1-pathB, vendor2-pathA, vendor3-pathB, ...
# NETWORKS="3 4"

# Space-separated FQDNs (or substrings) of hosts to exclude from all stages.
# Use this to skip the provisioner node, masters, or any host that should
# not get storage VLAN interfaces.
# EXCLUDE_HOSTS=""

# Target deployment type. Affects SSH user and host-setup method.
#   ocp    — OpenShift (SSH user: core)
#   vmware — ESXi hosts (SSH user: root)
#   bare   — plain bare-metal (SSH user: root)
# TARGET_TYPE="ocp"

# Override the SSH user if needed (auto-set from TARGET_TYPE otherwise).
# SSH_USER="core"

# Bitwarden Secrets Manager project ID holding the storage credentials.
# Optional: when set, `bws secret list` is scoped to this project instead of
# listing everything the service account can read.
# BWS_PROJECT_ID=""

# QUADS API base URL. Only change if using a non-standard QUADS instance.
# QUADS_API="https://quads2.rdu2.scalelab.redhat.com/api/v3"

# The outer Q-in-Q VLAN for cloud99 (Storage LTA). The Jira draft will
# request VLAN membership changes to this VLAN.
# CLOUD99_OUTER_VLAN="2080"

# ---- Volume/LUN configuration (for storage-setup stage) --------------------

# Size of each volume/LUN to create per vendor.
# Accepts storage-standard size strings: "1TB", "500GB", "2TB", etc.
LUN_SIZE="1TB"

# Number of volumes/LUNs to create per vendor for this cloud.
# Each gets a sequential suffix: cloud06_iscsi_lta_ibm_vdisk01, _vdisk02, etc.
LUN_COUNT=1
